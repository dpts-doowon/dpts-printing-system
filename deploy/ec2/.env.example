# Copie para .env (chmod 600) e preencha. NUNCA versione o .env.
# Gere os segredos com:  openssl rand -hex 24   (DB_PASSWORD deve ser só letras e números, pois entra numa URL)
DB_PASSWORD=
SEED_ADMIN_PASSWORD=
SEED_OPERATOR_PASSWORD=
AGENT_TOKEN_ST1=
AGENT_TOKEN_ST2=
# Endereço público do sistema, exatamente como o navegador o acessa (sem barra no fim)
PUBLIC_URL=http://IP_OU_DOMINIO
# ":80" (padrão, HTTP) ou um domínio (HTTPS automático)
SITE_ADDRESS=:80
# Horários do logout forçado (PROVISÓRIO, D-013)
FORCED_LOGOUT_TIMES=15:30,00:30
# Backup: bucket S3 (criado por você) e quantos dias manter no servidor
BACKUP_BUCKET=
BACKUP_KEEP_DAYS=7
